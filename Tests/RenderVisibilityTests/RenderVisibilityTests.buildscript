[project:RenderVisibilityTests]
type = exe
outdir = ../../bin/
if(Windows)
{
    subsystem = Console
}
sources = src/main.cpp
headers = src/**/*.hpp
# renderer.hpp invokes the EngineGraphics-owned UI managers at frame finalization.
# The CPU-only fixture still instantiates that production path, so it must link
# the DLL that owns those exported implementations.
includes = src, ../../Engine/Thirdparty/imgui-docking
target_link_libraries(
    PRIVATE EngineCore
    PRIVATE EngineGraphics
)
multiprocessor = true
simd = AdvancedVectorExtensions2
std = 20
utf8 = true
exception_handling = false
buffer_security_check = false
