find_package(Vulkan REQUIRED)
if(Linux)
{
    find_package(SDL3 REQUIRED)
}
if(macOS)
{
    find_package(SDL3 REQUIRED)
}
if(Windows)
{
find_package(DirectX12 REQUIRED)
}

[project:Editor]
type = exe
outdir = ../../bin/
if(Windows)
{
    subsystem = Console
}
sources = {
    src/**/*.cpp
    ../../Engine/Thirdparty/imgui-docking/backends/imgui_impl_sdlrenderer3.cpp
}
defines = IMGUI_IMPL_API=
headers = src/**/*.hpp
includes = {
    src
    ../../Engine/src
    ../../Engine/Thirdparty/include
    ../../Engine
    ../../Engine/Thirdparty/OpenXR-SDK-1.1.59/include
    ../../Engine/Thirdparty/RmlUi-6.2/Include
    ../../Engine/Thirdparty/RmlUi-6.2/Backends
    ../../Engine/Thirdparty/SDL3-3.4.4/include
    ../../Engine/Thirdparty/freetype/include
    ../../Engine/Thirdparty/ImGuizmo
    ../../Engine/Thirdparty/imgui-docking
    ../../Engine/Thirdparty/imgui-docking/backends
    ../../Engine/Thirdparty/vma/include
    ../../Engine/Thirdparty/vk-bootstrap/src
    ../../Engine/Thirdparty/bc7enc
    ../../Engine/Thirdparty/recastnavigation/Recast/Include
    ../../Engine/Thirdparty/recastnavigation/Detour/Include
    ../../Engine/Thirdparty/meshoptimizer/src
    ../../Engine/Thirdparty/miniaudio
    ../../Engine/Thirdparty/JoltPhysics-5.5.0
    ../../Engine/Thirdparty/Pakker/src
    ../../Engine/Thirdparty/enet/src
    ../../Engine/Thirdparty/entt/src
    ../../Engine/Thirdparty/spdlog-1.15.3/include
    ../../Engine/Thirdparty/tinyobjloader
    ../../Engine/Thirdparty/tinygltf-2.9.6
    ../../Engine/Thirdparty/glm
}
if(Windows)
{
    libs = ${Vulkan_LIBRARIES}, ${DirectX12_LIBRARIES}, user32.lib, SDL3.lib
    libdirs = ${Vulkan_LIBRARY_DIRS}, ${DirectX12_LIBRARY_DIRS}, ../../bin, ../../Engine/Thirdparty/SDL3-3.4.4/lib/x64
}
if(Linux)
{
    libs = ${Vulkan_LIBRARIES}, ${SDL3_LIBRARIES}
    libdirs = ${Vulkan_LIBRARY_DIRS}, ${SDL3_LIBRARY_DIRS}, ../../bin
    ldflags = -Wl,-rpath,/opt/homebrew/lib
}
if(macOS)
{
    libs = ${Vulkan_LIBRARIES}, ${SDL3_LIBRARIES}, -framework Metal, -framework QuartzCore, -framework Cocoa, -framework Foundation, -lobjc
    libdirs = ${Vulkan_LIBRARY_DIRS}, ${SDL3_LIBRARY_DIRS}, ../../bin
}
target_link_libraries(
    PRIVATE EngineCore
    PRIVATE EngineGraphics
)
multiprocessor = true
simd = AdvancedVectorExtensions2
std = 20
utf8 = true
exception_handling = true
buffer_security_check = false
